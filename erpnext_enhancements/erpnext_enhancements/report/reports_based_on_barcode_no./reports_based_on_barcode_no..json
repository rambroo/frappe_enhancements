 "query": "SELECT \n    i.item_code AS \"Item Code\", \n    i.item_name AS \"Item Name\", \n    COALESCE(ib.barcode, 'No Barcode') AS \"Barcode Number\"\nFROM \n    `tabItem` i\nLEFT JOIN \n    `tabItem Barcode` ib ON i.item_code = ib.parent\nWHERE \n    i.disabled = 0\nORDER BY \n    i.item_code ASC;\n",
